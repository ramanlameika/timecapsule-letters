# ──────────────────────────────────────────────
# TimeCapsule Letters – environment variables
# Copy this file to .env and fill in the values.
# ──────────────────────────────────────────────

# ── Database ────────────────────────────────
DATABASE_URL=postgresql://timecapsule:timecapsule@postgres:5432/timecapsule

# ── Redis / Celery ───────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Encryption ──────────────────────────────
# Generate a key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LETTER_ENCRYPTION_KEY=

# ── Public base URL (used in verification links) ──
BASE_URL=http://localhost:8000

# ── SMTP (leave blank to use dev log-only mode) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@timecapsule.local
SMTP_TLS=true

# ── App environment ("dev" skips real SMTP) ──
ENVIRONMENT=dev
